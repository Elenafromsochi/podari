# Шаблон переменных окружения для self-hosted (сервер Timeweb).
# Скопируй в /opt/podari/.env и подставь реальные значения.
#   cp /opt/podari/deploy/.env.example /opt/podari/.env
#   nano /opt/podari/.env
#
# Ключи Supabase лежат на сервере: cat /root/supabase-secrets.txt

# ====== Сборка фронтенда (VITE_* попадают в клиентский код при build) ======
# ВАЖНО: это адрес и anon-ключ ВАШЕГО Supabase на сервере, НЕ облачного.
VITE_SUPABASE_URL=https://api.23podari.ru
VITE_SUPABASE_PUBLISHABLE_KEY=ЗАМЕНИ_anon_key_из_supabase-secrets

# ====== Сервер: Supabase ======
SUPABASE_URL=https://api.23podari.ru
SUPABASE_PUBLISHABLE_KEY=ЗАМЕНИ_anon_key_из_supabase-secrets
SUPABASE_SERVICE_ROLE_KEY=ЗАМЕНИ_service_role_key_из_supabase-secrets

# ====== Сервер: общее ======
APP_URL=https://23podari.ru

# ====== Telegram-бот (значения возьми из настроек Cloudflare/BotFather) ======
TELEGRAM_BOT_TOKEN=ЗАМЕНИ_токен_бота
TELEGRAM_BOT_USERNAME=Podari_podarki_bot
TELEGRAM_WEBHOOK_SECRET=ЗАМЕНИ_секрет_вебхука

# ====== ИИ через российский proxyapi.ru ======
AI_BASE_URL=https://api.proxyapi.ru/openai/v1
AI_API_KEY=ЗАМЕНИ_ключ_proxyapi
AI_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-1
AI_TRANSCRIBE_MODEL=whisper-1

# ====== Запуск Node-сервера ======
PORT=3000
HOST=127.0.0.1
