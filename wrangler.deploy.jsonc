{
  "name": "podari",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": { "directory": "dist/client", "binding": "ASSETS" },
  "vars": {
    "AI_BASE_URL": "https://api.proxyapi.ru/openai/v1",
    "AI_MODEL": "gpt-4o-mini",
    "AI_IMAGE_MODEL": "gpt-image-1",
    // Настоящий адрес Supabase для серверного кода (supabaseAdmin, обмен
    // токенов при входе и т.д.) — ЭТУ переменную сервер обязан использовать
    // напрямую, а не проксированный VITE_SUPABASE_URL (тот только для
    // браузера). Раньше эта переменная нигде явно не была задана в проде,
    // и серверный код по умолчанию проваливался на VITE_SUPABASE_URL —
    // пока там был тот же прямой адрес, это было незаметно; как только
    // VITE_SUPABASE_URL стал проксированным (/db), сервер начал сам себе
    // звонить по кругу и вход через Telegram/VK перестал работать.
    "SUPABASE_URL": "https://pvankvojplctgthlvtto.supabase.co",
  },
}
